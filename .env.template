# =============================================================================
# NammaClimaGrid — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in the values:
#     cp .env.template .env
# Never commit the real `.env` file to git.
# =============================================================================

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_IOT=iot-sensor-stream
KAFKA_TOPIC_WARD_FEATURES=ward-features-stream
KAFKA_TOPIC_ALERTS=climate-alerts
KAFKA_TOPIC_CITIZEN_REPORTS=citizen-reports

# ---------- Zookeeper (Kafka dependency) ----------
ZOOKEEPER_CLIENT_PORT=2181

# ---------- PostgreSQL + PostGIS ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=namma_clima_grid
POSTGRES_USER=ncg_user
POSTGRES_PASSWORD=change_me_in_production

# ---------- Redis (API cache) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------- Google Earth Engine (optional — for real satellite data) ----------
# Leave blank to fall back to cached sample scenes.
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_KEY_FILE=./secrets/gee_service_key.json

# ---------- Open-Meteo (free, no key needed) ----------
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ---------- IMD (optional) ----------
IMD_API_BASE_URL=https://imdpune.gov.in/

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_EXPERIMENT_NAME=namma_clima_grid

# ---------- TorchServe ----------
TORCHSERVE_HOST=localhost
TORCHSERVE_INFERENCE_PORT=8080
TORCHSERVE_MANAGEMENT_PORT=8081
TORCHSERVE_THERMAL_MODEL=thermal_vision
TORCHSERVE_STGNN_MODEL=stgnn_dual_stress

# ---------- FastAPI backend ----------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
SECRET_KEY=change_me_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:8088,http://localhost:8501

# ---------- Apache Airflow ----------
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://ncg_user:change_me_in_production@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ---------- Apache Superset ----------
SUPERSET_SECRET_KEY=change_me_use_openssl_rand_base64_42
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@nammaclimagrid.local

# ---------- Delta Lake ----------
DELTA_LAKE_ROOT=/data/delta
DELTA_TABLE_RAW_IOT=raw_iot
DELTA_TABLE_WARD_FEATURES=ward_features
DELTA_TABLE_SATELLITE_FEATURES=satellite_features

# ---------- Flink ----------
FLINK_JOBMANAGER_HOST=flink-jobmanager
FLINK_JOBMANAGER_PORT=8081

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- Project paths ----------
PROJECT_ROOT=/app
DATA_DIR=./8_data
MODEL_DIR=./models
CHECKPOINT_DIR=./checkpoints

# ---------- Bengaluru geographic bounds (for satellite + mock sensors) ----------
BENGALURU_BBOX_WEST=77.45
BENGALURU_BBOX_SOUTH=12.83
BENGALURU_BBOX_EAST=77.78
BENGALURU_BBOX_NORTH=13.14
