{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "NammaClimaGrid PostgreSQL",
      "description": "PostgreSQL/PostGIS database for ward features and IoT data",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    },
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus metrics for API and ML model performance",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Critical Alerts",
        "rawQuery": true,
        "rawSql": "SELECT created_at AS time, 'CRITICAL: ' || ward_name AS text, risk_level AS tags FROM ward_risk_scores JOIN wards USING (ward_id) WHERE risk_level = 'critical' AND created_at > NOW() - INTERVAL '1 hour' ORDER BY created_at",
        "showIn": 0,
        "timeColumn": "time",
        "titleColumn": "text"
      }
    ]
  },
  "description": "NammaClimaGrid — IoT sensor monitoring, ML model performance, and real-time ward stress tracking",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Superset Dashboard",
      "tooltip": "Open Superset ward stress dashboard",
      "type": "link",
      "url": "http://localhost:8089/superset/dashboard/ward-stress/"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "API Docs",
      "tooltip": "FastAPI interactive docs",
      "type": "link",
      "url": "http://localhost:8000/docs"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🌡️ City-Wide KPIs",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 40 }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Critical Wards",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "format": "time_series",
        "rawQuery": true,
        "rawSql": "SELECT updated_at AS time, COUNT(*) AS value FROM ward_risk_scores WHERE risk_level = 'critical' GROUP BY updated_at ORDER BY updated_at",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "short",
          "decimals": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Avg Heat Stress",
      "type": "stat",
      "targets": [{
        "rawSql": "SELECT updated_at AS time, ROUND(AVG(heat_stress_score)::numeric, 1) AS value FROM ward_risk_scores GROUP BY updated_at ORDER BY updated_at",
        "rawQuery": true, "format": "time_series", "refId": "A"
      }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "light-blue", "value": 30 },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "short",
          "decimals": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Avg Flood Risk",
      "type": "stat",
      "targets": [{
        "rawSql": "SELECT updated_at AS time, ROUND(AVG(flood_risk_score)::numeric, 1) AS value FROM ward_risk_scores GROUP BY updated_at ORDER BY updated_at",
        "rawQuery": true, "format": "time_series", "refId": "A"
      }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 40 }]
          },
          "unit": "celsius"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Avg LST (CNN-ViT)",
      "type": "stat",
      "targets": [{
        "rawSql": "SELECT updated_at AS time, ROUND(AVG(lst_pred_celsius)::numeric, 1) AS value FROM ward_risk_scores GROUP BY updated_at ORDER BY updated_at",
        "rawQuery": true, "format": "time_series", "refId": "A"
      }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Active IoT Sensors",
      "type": "stat",
      "targets": [{
        "rawSql": "SELECT NOW() AS time, COUNT(DISTINCT sensor_id) AS value FROM iot_readings WHERE ts > NOW() - INTERVAL '10 minutes'",
        "rawQuery": true, "format": "time_series", "refId": "A"
      }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Kafka Messages/min",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "rate(kafka_server_brokertopicmetrics_messagesinpersec_total{topic=\"ward-features\"}[1m]) * 60",
        "legendFormat": "Messages/min",
        "refId": "A"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📡 IoT Sensor Streams",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "celsius" },
        "overrides": [{ "matcher": { "id": "byName", "options": "pm25" }, "properties": [{ "id": "unit", "value": "µg/m³" }, { "id": "custom.axisPlacement", "value": "right" }] }]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "legend": { "calcs": ["lastNotNull", "max", "min"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } },
      "title": "IoT Sensor Readings — Top 5 Hottest Wards",
      "type": "timeseries",
      "targets": [{
        "rawSql": "SELECT ts AS time, sensor_id AS metric, lst_celsius AS value FROM iot_readings WHERE ward_id IN (SELECT ward_id FROM ward_risk_scores ORDER BY heat_stress_score DESC LIMIT 5) AND ts > NOW() - INTERVAL '${__from:date}' ORDER BY time",
        "rawQuery": true, "format": "time_series", "refId": "A"
      }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "mm" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "title": "Rainfall Accumulation (mm) — Real-time",
      "type": "timeseries",
      "targets": [{
        "rawSql": "SELECT ts AS time, w.ward_name AS metric, SUM(rainfall_mm) OVER (PARTITION BY i.ward_id ORDER BY ts) AS value FROM iot_readings i JOIN wards w ON i.ward_id = w.ward_id WHERE ts > NOW() - INTERVAL '24 hours' ORDER BY time",
        "rawQuery": true, "format": "time_series", "refId": "A"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "🤖 ML Model Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 5 }, "unit": "ms" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 15 },
      "id": 20,
      "options": { "legend": { "calcs": ["p99", "mean"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Inference Latency (p50/p99)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{handler=\"/wards/risk\"}[5m])) * 1000", "legendFormat": "p50 /wards/risk", "refId": "A" },
        { "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{handler=\"/wards/risk\"}[5m])) * 1000", "legendFormat": "p99 /wards/risk", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{handler=\"/interventions/recommend\"}[5m])) * 1000", "legendFormat": "p99 /interventions", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 5 }, "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 15 },
      "id": 21,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" } },
      "title": "API Request Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(http_requests_total{job=\"namma-clima-api\"}[1m])", "legendFormat": "{{handler}} {{status}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 5 }, "unit": "short", "decimals": 3 }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 15 },
      "id": 22,
      "options": { "legend": { "calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom" } },
      "title": "ST-GNN Validation RMSE (Heat / Flood)",
      "type": "timeseries",
      "targets": [{
        "rawSql": "SELECT logged_at AS time, metric_name AS metric, metric_value AS value FROM mlflow_metrics WHERE run_name LIKE 'st_gnn%' AND metric_name IN ('val_heat_rmse', 'val_flood_rmse') AND logged_at > NOW() - INTERVAL '7 days' ORDER BY time",
        "rawQuery": true, "format": "time_series", "refId": "A"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 103,
      "title": "🌿 RL Intervention Optimizer",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "short" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "id": 30,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "PPO Episode Reward Over Time",
      "type": "timeseries",
      "targets": [{
        "rawSql": "SELECT logged_at AS time, metric_value AS value FROM mlflow_metrics WHERE run_name LIKE 'ppo%' AND metric_name = 'ep_reward_mean' ORDER BY time",
        "rawQuery": true, "format": "time_series", "refId": "A"
      }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 50 }] }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "cost" }, "properties": [{ "id": "custom.width", "value": 60 }] },
          { "matcher": { "id": "byName", "options": "heat_reduction" }, "properties": [{ "id": "custom.displayMode", "value": "color-background" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] } }] }
        ]
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 23 },
      "id": 31,
      "options": { "footer": { "show": false }, "showHeader": true, "sortBy": [{ "displayName": "heat_reduction", "desc": true }] },
      "title": "Latest RL Recommendations",
      "type": "table",
      "targets": [{
        "rawSql": "SELECT ward_name, intervention_type, ROUND(expected_heat_reduction::numeric, 1) AS heat_reduction, ROUND(expected_flood_reduction::numeric, 1) AS flood_reduction, cost, created_at FROM interventions i JOIN wards w USING (ward_id) WHERE created_at > NOW() - INTERVAL '1 hour' ORDER BY created_at DESC LIMIT 20",
        "rawQuery": true, "format": "table", "refId": "A"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 104,
      "title": "⚙️ Infrastructure Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }] }
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 31 },
      "id": 40,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "name" },
      "title": "Service Health",
      "type": "stat",
      "targets": [
        { "expr": "up{job=\"kafka\"}",      "legendFormat": "Kafka",      "refId": "A" },
        { "expr": "up{job=\"postgres\"}",   "legendFormat": "PostgreSQL",  "refId": "B" },
        { "expr": "up{job=\"redis\"}",      "legendFormat": "Redis",      "refId": "C" },
        { "expr": "up{job=\"mlflow\"}",     "legendFormat": "MLflow",     "refId": "D" },
        { "expr": "up{job=\"airflow\"}",    "legendFormat": "Airflow",    "refId": "E" },
        { "expr": "up{job=\"flink\"}",      "legendFormat": "Flink",      "refId": "F" },
        { "expr": "up{job=\"namma-api\"}",  "legendFormat": "FastAPI",    "refId": "G" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["namma-clima-grid", "iot", "ml", "bengaluru"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "definition": "SELECT ward_name FROM wards ORDER BY ward_name",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "ward",
        "options": [],
        "query": "SELECT ward_name FROM wards ORDER BY ward_name",
        "refresh": 2,
        "type": "query",
        "label": "Ward"
      },
      {
        "current": { "selected": true, "text": "1h", "value": "1h" },
        "hide": 0,
        "name": "time_range",
        "options": [
          { "selected": false, "text": "15m", "value": "15m" },
          { "selected": true,  "text": "1h",  "value": "1h" },
          { "selected": false, "text": "6h",  "value": "6h" },
          { "selected": false, "text": "24h", "value": "24h" }
        ],
        "query": "15m,1h,6h,24h",
        "type": "custom",
        "label": "Time Range"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Kolkata",
  "title": "NammaClimaGrid — IoT & ML Monitoring",
  "uid": "namma-iot-monitoring",
  "version": 1,
  "weekStart": "monday"
}
