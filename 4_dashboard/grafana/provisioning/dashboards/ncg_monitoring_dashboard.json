      "id": 31,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "P5B7AC0252100194D"
          },
          "format": "table",
          "rawSql": "SELECT \n                    w.ward_name,\n                    r.ward_id,\n                    round(r.heat_stress_score::numeric, 1) as heat_stress,\n                    round(r.flood_risk_score::numeric, 1) as flood_risk,\n                    round((0.6*r.heat_stress_score + 0.4*r.flood_risk_score)::numeric, 1) as combined_risk,\n                    r.risk_level,\n                    round(r.ndvi::numeric, 3) as ndvi,\n                    round(r.impervious_pct::numeric, 1) as impervious_pct\n                  FROM ward_risk_scores r\n                  LEFT JOIN wards w ON w.ward_id = r.ward_id\n                  ORDER BY combined_risk DESC\n                  LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Ward Risk Matrix (Heat vs Flood)",
      "type": "table"
