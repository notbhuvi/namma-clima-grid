        {
          "datasource": {
            "type": "postgres",
            "uid": "P5B7AC0252100194D"
          },
          "format": "table",
          "rawSql": "SELECT \n                    w.ward_name,\n                    r.ward_id,\n                    round(r.heat_stress_score::numeric, 1) as heat_stress,\n                    round(r.flood_risk_score::numeric, 1) as flood_risk,\n                    r.risk_level,\n                    round(r.lst_pred_celsius::numeric, 1) as lst_celsius,\n                    round(r.ndvi::numeric, 3) as ndvi\n                  FROM ward_risk_scores r\n                  LEFT JOIN wards w ON w.ward_id = r.ward_id\n                  ORDER BY r.heat_stress_score DESC \n                  LIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Top 10 Heat Risk Wards",
