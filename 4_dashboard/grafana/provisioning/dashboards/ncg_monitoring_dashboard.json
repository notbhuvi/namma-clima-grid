          "format": "time_series",
          "rawSql": "SELECT \n                    recorded_at AS \"time\",\n                    temperature_c as \"Temperature \u00b0C\",\n                    ward_id::text as metric\n                  FROM weather_readings \n                  WHERE recorded_at > now() - interval '24 hours'\n                  ORDER BY recorded_at",
          "refId": "A"
        }
      ],
      "title": "Temperature Readings (Last 24h)",
