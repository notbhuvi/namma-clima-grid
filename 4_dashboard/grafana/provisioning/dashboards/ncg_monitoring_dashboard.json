          "rawSql": "SELECT \n                    cr.id, \n                    w.ward_name,\n                    cr.ward_id,\n                    cr.report_type,\n                    cr.severity,\n                    cr.description,\n                    cr.reported_at\n                  FROM citizen_reports cr\n                  LEFT JOIN wards w ON w.ward_id = cr.ward_id\n                  ORDER BY cr.reported_at DESC \n                  LIMIT 20",
          "refId": "A"
