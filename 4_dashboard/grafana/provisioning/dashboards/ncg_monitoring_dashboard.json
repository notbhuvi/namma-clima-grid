          "rawSql": "SELECT \n                    ward_id::text AS metric, \n                    round(avg(humidity_pct)::numeric, 1) AS value \n                  FROM weather_readings \n                  GROUP BY ward_id \n                  ORDER BY value DESC\n                  LIMIT 15",
