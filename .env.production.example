# NammaClimaGrid production environment example.
# Copy to your secret manager or deployment platform; do not commit real values.

NCG_ENV=production
AUTH_REQUIRED=true
REQUIRE_EXTERNAL_SERVICES=true
ALLOW_ALL_CORS=false
CORS_ORIGINS=https://your-domain.example

ADMIN_API_KEY=replace_with_32_plus_random_chars
RESEARCH_API_KEY=replace_with_optional_research_token
SECRET_KEY=replace_with_32_plus_random_chars

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=namma_clima_grid
POSTGRES_USER=ncg_user
POSTGRES_PASSWORD=replace_with_strong_database_password

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_IOT=iot-sensor-stream
KAFKA_TOPIC_WARD_FEATURES=ward-features-stream
KAFKA_TOPIC_ALERTS=climate-alerts
KAFKA_TOPIC_CITIZEN_REPORTS=citizen-reports

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

MLFLOW_TRACKING_URI=http://mlflow:5000
SUPERSET_SECRET_KEY=replace_with_strong_superset_secret
AIRFLOW__CORE__FERNET_KEY=replace_with_airflow_fernet_key

THERMAL_VISION_CHECKPOINT=2_thermal_vision/checkpoints/best_model.pt
STGNN_CHECKPOINT=3_st_gnn/checkpoints/gnn_best.pt
RL_CHECKPOINT=4_rl_optimizer/checkpoints/ppo_best.pt
UPLOAD_DIR=/app/5_backend/static/uploads
